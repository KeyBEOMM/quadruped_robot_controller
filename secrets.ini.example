; ============================================================
; secrets.ini 예시 파일 (secrets.ini.example)
; ============================================================
; secrets.ini를 만들 때 이 파일을 복사하여 실제 값을 입력하세요.
; 이 파일(.example)은 GitHub에 커밋해도 됩니다.
; ============================================================

[secrets]
wifi_ssid     = YOUR_SSID_HERE
wifi_password = YOUR_PASSWORD_HERE
